@rendermode InteractiveServer

@inject MoviesClient MoviesClient
@inject NavigationManager NavigationManager



<!-- Modal -->
<div class="modal fade" id="@GetDeleteConfirmModalId(Movie)[1..]" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">@title</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="@ConfirmDeleteAsync">Delete</button>
      </div>
    </div>
  </div>
</div>

@code {
   [Parameter]
   public MovieDto? Movie {get; set;}


   private string title = "";
   protected override void OnParametersSet(){
      title = $"Delete Movie: {Movie?.Name}";

   }

   public static string GetDeleteConfirmModalId(MovieDto movie){
      ArgumentNullException.ThrowIfNull(movie);

      //in modal it self we will need to remove the `#` i.e. id selector
      // and will do this by using csharps range operator [1..] start i.e. start from index 1 end stop at end of string
      return $"#deleteModal-{movie.Id}";
   }

   private async Task ConfirmDeleteAsync(){
      ArgumentNullException.ThrowIfNull(Movie);
      await MoviesClient.DeleteMovieAsync(Movie.Id);
      NavigationManager.NavigateTo("/");
   }

}
